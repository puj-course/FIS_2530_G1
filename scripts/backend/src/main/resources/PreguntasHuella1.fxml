      <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="14.0" layoutY="54.0" pickOnBounds="true" preserveRatio="true" />

      <Pane layoutX="145.0" layoutY="15.0" prefHeight="380.0" prefWidth="410.0" style="-fx-background-color: black;">
